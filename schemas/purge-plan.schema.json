{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kiron0/swipr/schemas/purge-plan.schema.json",
  "title": "Swipr purge-plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "created_at": {
      "type": "string"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "action": {
      "const": "permanent-delete-quarantined-bytecode"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "quarantined": {
            "type": "string"
          },
          "identity": {
            "type": "object",
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0
              },
              "inode": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mtime_ns": {
                "type": "integer"
              },
              "ctime_ns": {
                "type": "integer"
              },
              "links": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "device",
              "inode",
              "mode",
              "size",
              "mtime_ns",
              "ctime_ns",
              "links"
            ],
            "additionalProperties": false
          },
          "quarantine_identity": {
            "type": "object",
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0
              },
              "inode": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mtime_ns": {
                "type": "integer"
              },
              "ctime_ns": {
                "type": "integer"
              },
              "links": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "device",
              "inode",
              "mode",
              "size",
              "mtime_ns",
              "ctime_ns",
              "links"
            ],
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "quarantined",
              "failed-stop"
            ]
          },
          "reason": {
            "type": "string"
          },
          "concurrent_name_restored": {
            "type": "boolean"
          }
        },
        "required": [
          "candidate_id",
          "original",
          "quarantined",
          "identity",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "expires_at": {
      "type": "number"
    },
    "irreversible": {
      "const": true
    },
    "warning": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rule_catalog_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "created_at",
    "operation_id",
    "action",
    "items",
    "expires_at",
    "irreversible",
    "warning",
    "digest",
    "rule_catalog_digest"
  ],
  "additionalProperties": false
}
