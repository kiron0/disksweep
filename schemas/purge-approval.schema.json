{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kiron0/disksweep/schemas/purge-approval.schema.json",
  "title": "DiskSweep purge-approval",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "action": {
      "const": "permanent-delete-quarantined-bytecode"
    },
    "expires_at": {
      "type": "number"
    },
    "approval_note": {
      "type": "string"
    },
    "acknowledge_irreversible": {
      "const": true
    }
  },
  "required": [
    "id",
    "plan_id",
    "digest",
    "action",
    "expires_at",
    "approval_note",
    "acknowledge_irreversible"
  ],
  "additionalProperties": false
}
