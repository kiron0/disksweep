{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kiron0/disksweep/schemas/plan.schema.json",
  "title": "DiskSweep plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "number"
    },
    "action": {
      "const": "quarantine"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "path": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "identity": {
            "type": "object",
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0
              },
              "inode": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mtime_ns": {
                "type": "integer"
              },
              "ctime_ns": {
                "type": "integer"
              },
              "links": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "device",
              "inode",
              "mode",
              "size",
              "mtime_ns",
              "ctime_ns",
              "links"
            ],
            "additionalProperties": false
          },
          "logical_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "allocated_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "unique_inode": {
            "type": "boolean"
          },
          "classification": {
            "enum": [
              "SAFE-CANDIDATE",
              "REVIEW",
              "PROTECTED",
              "UNSUPPORTED"
            ]
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule_version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "application": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "moderate",
              "high",
              "critical"
            ]
          },
          "reason": {
            "type": "string"
          },
          "side_effects": {
            "type": "string"
          },
          "recovery": {
            "type": "string"
          },
          "strategy": {
            "enum": [
              "audit-only",
              "quarantine-bytecode"
            ]
          },
          "evidence": {
            "type": [
              "object",
              "null"
            ]
          },
          "active_use": {
            "const": "unknown"
          }
        },
        "required": [
          "id",
          "path",
          "root",
          "identity",
          "logical_bytes",
          "allocated_bytes",
          "unique_inode",
          "classification",
          "rule_id",
          "rule_version",
          "application",
          "category",
          "risk",
          "reason",
          "side_effects",
          "recovery",
          "strategy",
          "evidence",
          "active_use"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "rule_catalog_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_immediate_free_bytes": {
      "const": 0
    },
    "warning": {
      "type": "string"
    },
    "requires": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "created_at",
    "expires_at",
    "action",
    "entries",
    "rule_catalog_digest",
    "exclude",
    "roots",
    "estimated_immediate_free_bytes",
    "warning",
    "requires",
    "digest"
  ],
  "additionalProperties": false
}
