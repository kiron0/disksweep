{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kiron0/disksweep/schemas/operation.schema.json",
  "title": "DiskSweep operation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "quarantined": {
            "type": "string"
          },
          "identity": {
            "type": "object",
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0
              },
              "inode": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mtime_ns": {
                "type": "integer"
              },
              "ctime_ns": {
                "type": "integer"
              },
              "links": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "device",
              "inode",
              "mode",
              "size",
              "mtime_ns",
              "ctime_ns",
              "links"
            ],
            "additionalProperties": false
          },
          "quarantine_identity": {
            "type": "object",
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0
              },
              "inode": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mtime_ns": {
                "type": "integer"
              },
              "ctime_ns": {
                "type": "integer"
              },
              "links": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "device",
              "inode",
              "mode",
              "size",
              "mtime_ns",
              "ctime_ns",
              "links"
            ],
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "quarantined",
              "failed-stop"
            ]
          },
          "reason": {
            "type": "string"
          },
          "concurrent_name_restored": {
            "type": "boolean"
          }
        },
        "required": [
          "candidate_id",
          "original",
          "quarantined",
          "identity",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "before_free": {
      "type": "integer",
      "minimum": 0
    },
    "after_free": {
      "type": "integer",
      "minimum": 0
    },
    "observed_free_delta": {
      "type": "integer"
    },
    "estimated_immediate_free_bytes": {
      "const": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "plan_id",
    "approval_id",
    "started_at",
    "finished_at",
    "status",
    "items",
    "before_free",
    "after_free",
    "observed_free_delta",
    "estimated_immediate_free_bytes"
  ],
  "additionalProperties": false
}
