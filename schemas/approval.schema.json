{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kiron0/disksweep/schemas/approval.schema.json",
  "title": "DiskSweep approval",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string"
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "number"
    },
    "approval_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "action": {
      "const": "quarantine"
    },
    "workload_stopped": {
      "const": true
    }
  },
  "required": [
    "id",
    "plan_id",
    "plan_digest",
    "candidate_ids",
    "expires_at",
    "approval_note",
    "action",
    "workload_stopped"
  ],
  "additionalProperties": false
}
